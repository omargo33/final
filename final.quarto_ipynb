      "Número promedio de palabras: 16.97\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1152x480 with 2 Axes>"
      ]
     },
     "metadata": {
      "image/png": {
       "height": 470,
