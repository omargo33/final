      "  Std: 0.2395\n"
     ]
    }
   ],
   "source": [
    "print(\"=== DIVISIÓN DE DATOS\")\n",
    "\n",
    "# División simple para regresión\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_final, y_final, \n",
    "    test_size=0.2, \n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(f\"\\nDistribución del target (toxicity_score):\")\n",
    "print(f\"  Entrenamiento - Media: {y_train.mean():.4f}\") \n",
    "print(f\"  Std: {y_train.std():.4f}\")\n",
    "print(f\"  Prueba - Media: {y_test.mean():.4f}\")\n",
    "print(f\"  Std: {y_test.std():.4f}\")"
   ]
  }
 ],
